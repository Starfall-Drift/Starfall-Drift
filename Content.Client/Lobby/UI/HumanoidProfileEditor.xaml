<BoxContainer
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:starfallLoadouts="clr-namespace:Content.Client._Starfall.UserInterface.Lobby.Loadouts"
    xmlns:starfallRoles="clr-namespace:Content.Client._Starfall.UserInterface.Lobby.Roles"
    xmlns:starfallTraits="clr-namespace:Content.Client._Starfall.UserInterface.Lobby.Traits"
    HorizontalExpand="True"
    VerticalExpand="True">

    <!-- Main profile editor -->
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="10"
                  SeparationOverride="8">

        <!-- Profile-wide actions -->
        <PanelContainer StyleClasses="StarfallProfileHeader">

            <BoxContainer Orientation="Horizontal"
                          SeparationOverride="5">

                <Label Text="Editing Profile"
                       StyleClasses="StarfallProfileTitle"
                       VAlign="Center"
                       HorizontalExpand="True" />

                <Button Name="SaveButton"
                        Text="{Loc 'humanoid-profile-editor-save-button'}"
                        StyleClasses="positive" />

                <Button Name="ImportButton"
                        Text="{Loc 'humanoid-profile-editor-import-button'}" />

                <Button Name="ExportButton"
                        Text="{Loc 'humanoid-profile-editor-export-button'}" />

                <cc:VSeparator Margin="8 2" />

                <controls:ConfirmButton
                    Name="RandomizeEverythingButton"
                    Text="{Loc 'humanoid-profile-editor-randomize-everything-button'}"
                    ConfirmationText="{Loc 'humanoid-profile-editor-confirm-randomize'}" />

                <controls:ConfirmButton
                    Name="ResetButton"
                    Disabled="True"
                    Text="{Loc 'humanoid-profile-editor-reset-button'}"
                    ConfirmationText="{Loc 'humanoid-profile-editor-confirm-reset'}"
                    StyleClasses="negative" />
            </BoxContainer>
        </PanelContainer>

        <TabContainer Name="TabContainer"
                      HorizontalExpand="True"
                      VerticalExpand="True">

            <!--0: Identity Tab -->
            <ScrollContainer HorizontalExpand="True"
                             VerticalExpand="True"
                             HScrollEnabled="False">

                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              Margin="12"
                              SeparationOverride="10">

                    <PanelContainer StyleClasses="StarfallProfileCard"
                                    HorizontalExpand="True">

                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="8">

                            <PanelContainer StyleClasses="StarfallProfileHeader">

                                <Label Text="Identity"
                                       StyleClasses="StarfallProfileTitle" />
                            </PanelContainer>

                            <!-- Name -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="{Loc 'humanoid-profile-editor-name-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <LineEdit Name="NameEdit"
                                          MinWidth="270"
                                          MaxWidth="420" />

                                <Button Name="NameRandomize"
                                        Text="{Loc 'humanoid-profile-editor-name-random-button'}" />
                            </BoxContainer>

                            <!-- Age -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="{Loc 'humanoid-profile-editor-age-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <LineEdit Name="AgeEdit"
                                          MinWidth="80" />

                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Species -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="{Loc 'humanoid-profile-editor-species-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <OptionButton Name="SpeciesButton"
                                              MinWidth="220"
                                              MaxWidth="320" />

                                <TextureButton Name="SpeciesInfoButton"
                                               Scale="0.3 0.3"
                                               VerticalAlignment="Center"
                                               ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}" />
                            </BoxContainer>

                            <!-- Pronouns -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <OptionButton Name="PronounsButton"
                                              MinWidth="220" />

                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Spawn priority -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <OptionButton Name="SpawnPriorityButton"
                                              MinWidth="220" />

                                <Control HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>
                    <!-- Flavor Text -->
                    <PanelContainer Name="FlavorTextSection"
                                    StyleClasses="StarfallProfileCard"
                                    HorizontalExpand="True"
                                    Visible="False">

                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="8">

                            <PanelContainer StyleClasses="StarfallProfileHeader">
                                <Label Text="{Loc 'humanoid-profile-editor-flavortext-tab'}"
                                       StyleClasses="StarfallProfileTitle" />
                            </PanelContainer>

                            <BoxContainer Name="FlavorTextContainer"
                                          Orientation="Vertical"
                                          HorizontalExpand="True" />

                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>

            <!-- 1: Appearance -->
            <ScrollContainer HorizontalExpand="True"
                             VerticalExpand="True"
                             HScrollEnabled="False">

                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              Margin="12"
                              SeparationOverride="10">

                    <PanelContainer StyleClasses="StarfallProfileCard"
                                    HorizontalExpand="True">

                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="8">

                            <PanelContainer StyleClasses="StarfallProfileHeader">

                                <Label Text="Body"
                                       StyleClasses="StarfallProfileTitle" />
                            </PanelContainer>

                            <!-- Species  -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="{Loc 'humanoid-profile-editor-species-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <OptionButton Name="AppearanceSpeciesButton"
                                              MinWidth="220"
                                              MaxWidth="320" />
                            </BoxContainer>

                            <!-- Sex (Body type) -->
                            <BoxContainer Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="Body Type"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <OptionButton Name="SexButton"
                                              MinWidth="220" />

                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Skin color type -->
                            <BoxContainer Name="SkinTypeContainer"
                                          Visible="False"
                                          Orientation="Horizontal"
                                          HorizontalExpand="True"
                                          SeparationOverride="6">

                                <Label Text="{Loc 'humanoid-profile-editor-skin-type-label'}"
                                       VAlign="Center"
                                       MinWidth="150" />

                                <OptionButton Name="SkinTypeButton"
                                              MinWidth="220" />

                                <Control HorizontalExpand="True" />
                            </BoxContainer>

                            <PanelContainer StyleClasses="LowDivider"
                                            MinHeight="1"
                                            Margin="0 4" />

                            <!-- Skin color -->
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          SeparationOverride="4">

                                <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />

                                <Slider Name="Skin"
                                        HorizontalExpand="True"
                                        MinValue="0"
                                        MaxValue="100"
                                        Value="20" />

                                <BoxContainer Name="RgbSkinColorContainer"
                                              Visible="False"
                                              Orientation="Vertical"
                                              HorizontalExpand="True" />
                            </BoxContainer>

                            <!-- Eye color -->
                            <BoxContainer Orientation="Vertical"
                                          HorizontalExpand="True"
                                          SeparationOverride="4">

                                <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" />

                                <humanoid:EyeColorPicker Name="EyeColorPicker"
                                                        HorizontalExpand="True" />
                            </BoxContainer>
                        </BoxContainer>
                    </PanelContainer>

                    <!-- Markings -->
                    <PanelContainer StyleClasses="StarfallProfileCard"
                                    HorizontalExpand="True">

                        <BoxContainer Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="7">

                            <PanelContainer StyleClasses="StarfallProfileHeader">

                                <Label Text="Markings"
                                       StyleClasses="StarfallProfileTitle" />
                            </PanelContainer>

                            <humanoid:MarkingPicker Name="Markings"
                                                    HorizontalExpand="True"
                                                    MinHeight="600" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </ScrollContainer>

            <!-- 2: Loadout -->
            <starfallLoadouts:StarfallLoadoutEditor
                Name="LoadoutEditor"
                HorizontalExpand="True"
                VerticalExpand="True" />

            <!-- 3: Roles -->
            <starfallRoles:StarfallRolesEditor
                Name="RolesEditor"
                HorizontalExpand="True"
                VerticalExpand="True" />

            <!-- 4: Traits -->
            <starfallTraits:StarfallTraitsEditor
                Name="TraitsEditor"
                HorizontalExpand="True"
                VerticalExpand="True" />
        </TabContainer>
    </BoxContainer>

    <!-- Character preview -->
    <PanelContainer StyleClasses="StarfallProfilePreview"
                    MinWidth="260"
                    Margin="0 10 10 10">

        <BoxContainer Orientation="Vertical"
                      VerticalExpand="True"
                      VerticalAlignment="Center"
                      SeparationOverride="8">

            <profile:ProfilePreviewSpriteView Name="SpriteView"
                                              Scale="8 8"
                                              Margin="4"
                                              SizeFlagsStretchRatio="1" />

            <BoxContainer Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          SeparationOverride="4">

                <Button Name="SpriteRotateLeft"
                        Text="◀"
                        StyleClasses="OpenRight" />

                <cc:VSeparator Margin="2 0" />

                <Button Name="SpriteRotateRight"
                        Text="▶"
                        StyleClasses="OpenLeft" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider"
                            MinHeight="1"
                            Margin="12 6" />

            <BoxContainer Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          SeparationOverride="10">

                <Label Text="Preview Clothing"
                       StyleClasses="StarfallLobbyMuted"
                       VAlign="Center" />

                <controls:SwitchButton Name="ShowClothes"
                                       Pressed="True" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider"
                            MinHeight="1"
                            Margin="12 6" />

            <BoxContainer Orientation="Horizontal"
                          HorizontalAlignment="Center"
                          SeparationOverride="5">

                <Button Name="ExportImageButton"
                        Text="{Loc 'humanoid-profile-editor-export-image-button'}" />

                <Button Name="OpenImagesButton"
                        Text="{Loc 'humanoid-profile-editor-open-image-button'}" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
