<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:canvas="clr-namespace:Content.Client._AS.CanvasDesign.UI"
                      Title="{Loc 'canvas-design-preview-title'}"
                      Resizable="False">
  <BoxContainer Orientation="Vertical" Margin="8">
    <Label Name="SignName" StyleClasses="LabelHeading" HorizontalAlignment="Center" />
    <RichTextLabel Name="SignDescription" Margin="0 4 0 8" />
    <canvas:CanvasDesignControl Name="Canvas" MouseFilter="Ignore" />
  </BoxContainer>
</controls:FancyWindow>
