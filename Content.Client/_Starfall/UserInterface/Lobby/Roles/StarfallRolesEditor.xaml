<roles:StarfallRolesEditor
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:roles="clr-namespace:Content.Client._Starfall.UserInterface.Lobby.Roles"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    HorizontalExpand="True"
    VerticalExpand="True">

    <TabContainer Name="RolesTabContainer"
                  HorizontalExpand="True"
                  VerticalExpand="True">

        <!-- Jobs -->
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="8"
                      SeparationOverride="8">

            <PanelContainer StyleClasses="StarfallProfileCard"
                            HorizontalExpand="True">

                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              SeparationOverride="8">

                    <Label Text="{Loc 'starfall-roles-unavailable-label'}"
                           VerticalAlignment="Center" />

                    <OptionButton Name="PreferenceUnavailableButton"
                                  Access="Public"
                                  MinWidth="220"
                                  MaxWidth="300" />

                    <Control HorizontalExpand="True" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="StarfallProfileCard"
                            HorizontalExpand="True">

                <BoxContainer Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="6">

                    <ContainerButton Name="EnabledJobsHeader"
                                     HorizontalExpand="True">

                        <BoxContainer Orientation="Horizontal"
                                      HorizontalExpand="True"
                                      SeparationOverride="7"
                                      MouseFilter="Ignore">

                            <Label Name="EnabledJobsChevron"
                                   Text="▶" />

                            <Label Text="Enabled Jobs"
                                   StyleClasses="StarfallProfileTitle"
                                   HorizontalExpand="True" />

                            <Label Name="EnabledJobsCount"
                                   Text="0" />
                        </BoxContainer>
                    </ContainerButton>

                    <PanelContainer Name="EnabledJobsPanel"
                                    Visible="False"
                                    HorizontalExpand="True">

                        <BoxContainer Name="EnabledJobsList"
                                      Orientation="Vertical"
                                      HorizontalExpand="True" />
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="StarfallProfileCard"
                            HorizontalExpand="True">

                <BoxContainer Orientation="Horizontal"
                              HorizontalExpand="True"
                              SeparationOverride="8">

                    <LineEdit Name="JobSearch"
                              PlaceHolder="Search jobs..."
                              HorizontalExpand="True" />

                    <Button Name="JobSearchClearButton"
                            Text="Clear"
                            Disabled="True" />

                    <OptionButton Name="JobDepartmentFilter"
                                  MinWidth="220" />

                    <Label Text="Selected only"
                           VerticalAlignment="Center" />

                    <controls:SwitchButton
                        Name="JobSelectedOnly"
                        OffStateText=""
                        OnStateText=""
                        VerticalAlignment="Center" />
                </BoxContainer>
            </PanelContainer>

            <ScrollContainer HorizontalExpand="True"
                             VerticalExpand="True"
                             HScrollEnabled="False">

                <BoxContainer Name="JobList"
                              Orientation="Vertical"
                              HorizontalExpand="True" />
            </ScrollContainer>
        </BoxContainer>

        <!-- Antagonists -->
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      Margin="8">

            <ScrollContainer HorizontalExpand="True"
                             VerticalExpand="True"
                             HScrollEnabled="False">

                <BoxContainer Name="AntagList"
                              Orientation="Vertical"
                              HorizontalExpand="True" />
            </ScrollContainer>
        </BoxContainer>
    </TabContainer>
</roles:StarfallRolesEditor>
