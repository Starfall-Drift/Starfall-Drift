<roles:StarfallAntagCard
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:roles="clr-namespace:Content.Client._Starfall.UserInterface.Lobby.Roles"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    HorizontalExpand="True"
    VerticalExpand="True"
    MinWidth="300"
    StyleClasses="StarfallAntagCard">

    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  SeparationOverride="7">

        <!-- Icon/Title/Toggle -->
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="8">

            <PanelContainer Name="IconPanel"
                            StyleClasses="StarfallAntagIcon"
                            MinSize="66 66"
                            VerticalAlignment="Center">

                <TextureRect Name="Icon"
                             Stretch="KeepAspectCentered"
                             MinSize="62 62" />
            </PanelContainer>

            <ContainerButton Name="GuidebookButton"
                             StyleClasses="StarfallAntagTitleButton"
                             HorizontalExpand="True"
                             VerticalAlignment="Center">

                <Label Name="AntagName"
                       StyleClasses="StarfallAntagName"
                       MouseFilter="Ignore"
                       HorizontalExpand="True"
                       VerticalAlignment="Center"
                       ClipText="True" />
            </ContainerButton>

            <controls:SwitchButton Name="PreferenceToggle"
                       OffStateText=""
                       OnStateText=""
                       VerticalAlignment="Center" />
        </BoxContainer>

        <!-- Description -->
        <PanelContainer Name="DescriptionPanel"
                        StyleClasses="StarfallAntagDescription"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        MinHeight="72">

            <RichTextLabel Name="AntagDescription"
                           HorizontalExpand="True"
                           VerticalExpand="True"
                           VerticalAlignment="Top"
                           MaxWidth="340" />
        </PanelContainer>
    </BoxContainer>
</roles:StarfallAntagCard>
